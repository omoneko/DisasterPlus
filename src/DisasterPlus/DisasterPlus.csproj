<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build"
         xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildToolsPath)\Microsoft.Common.props"
          Condition="Exists('$(MSBuildToolsPath)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{6E1B0A62-5B4E-4C1F-9C1D-3F0A2D7C4B10}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>DisasterPlus</RootNamespace>
    <AssemblyName>DisasterPlus</AssemblyName>
    <TargetFrameworkVersion>v3.5</TargetFrameworkVersion>
    <LangVersion>7.3</LangVersion>
    <FileAlignment>512</FileAlignment>
    <!-- CitiesHarmony.API comes in through a PackageReference (NuGet restore).
         There is no CitiesHarmony.API.dll in the Workshop folder - each mod redistributes
         its own copy - so with a HintPath the reference target is never stable (Task 11). -->
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <WarningLevel>4</WarningLevel>
    <!-- Let CS0184 (an "is" test that is always false) slip by as a warning and a mistaken
         inheritance chain silently kills the feature. Promote it to an error. -->
    <WarningsAsErrors>0184</WarningsAsErrors>
  </PropertyGroup>

  <!-- Do not bake in machine-specific paths. When the environment variable is not set,
       use the default Steam path. -->
  <PropertyGroup>
    <ManagedDir Condition=" '$(CITIES_SKYLINES_MANAGED)' != '' ">$(CITIES_SKYLINES_MANAGED)</ManagedDir>
    <ManagedDir Condition=" '$(ManagedDir)' == '' ">C:\Program Files (x86)\Steam\steamapps\common\Cities_Skylines\Cities_Data\Managed</ManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="ICities">
      <HintPath>$(ManagedDir)\ICities.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="ColossalManaged">
      <HintPath>$(ManagedDir)\ColossalManaged.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- Harmony is used in this mod for one thing only (VortexPinPatch).
       CitiesHarmony.API pulls in HarmonyLib (CitiesHarmony.Harmony) transitively, so a single
       reference line is enough.
       HarmonyLib itself is supplied at run time by the CitiesHarmony mod, so it is not shipped
       with this mod (already excluded in the nuspec). -->
  <ItemGroup>
    <PackageReference Include="CitiesHarmony.API" Version="2.2.0" />
  </ItemGroup>

  <!-- Globs. Adding a new file does not mean having to touch the csproj. -->
  <ItemGroup>
    <Compile Include="Core\**\*.cs" />
    <Compile Include="Game\**\*.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>

  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
