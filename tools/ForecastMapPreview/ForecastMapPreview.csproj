<Project Sdk="Microsoft.NET.Sdk">
  <!-- A development tool for drawing what the forecast panel puts on the map (the track,
       the storm-wind area, the wind distribution) and checking it without starting the game.
       It is not part of the mod itself (net35).
       It compiles only Core, directly, so **the same formulas as in the game** run. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>DisasterPlus.Tools.ForecastMapPreview</RootNamespace>
    <AssemblyName>ForecastMapPreview</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\DisasterPlus\Core\**\*.cs" />
    <Compile Include="..\Shared\*.cs" />
    <Compile Include="**\*.cs" Exclude="bin\**\*.cs;obj\**\*.cs" />
  </ItemGroup>
</Project>
