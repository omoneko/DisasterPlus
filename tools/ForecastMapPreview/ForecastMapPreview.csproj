<Project Sdk="Microsoft.NET.Sdk">
  <!-- 予報パネルが地図に描くもの（進路・暴風域・風の分布）を、ゲームを起動せずに
       描いて確かめるための開発用ツール。MOD 本体（net35）には入らない。
       Core だけを直接コンパイルするので、**実機と同じ式**が走る。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>DisasterPlus.Tools.ForecastMapPreview</RootNamespace>
    <AssemblyName>ForecastMapPreview</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\DisasterPlus\Core\**\*.cs" />
    <Compile Include="..\Shared\*.cs" />
    <Compile Include="**\*.cs" Exclude="bin\**\*.cs;obj\**\*.cs" />
  </ItemGroup>
</Project>
