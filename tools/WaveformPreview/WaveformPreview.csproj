<Project Sdk="Microsoft.NET.Sdk">
  <!-- A development tool for drawing the synthetic seismogram (P wave, S wave, coda) and
       checking it without starting the game. It is not part of the mod itself (net35).
       It compiles only Core, directly. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>DisasterPlus.Tools.WaveformPreview</RootNamespace>
    <AssemblyName>WaveformPreview</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\DisasterPlus\Core\**\*.cs" />
    <Compile Include="..\Shared\*.cs" />
    <Compile Include="**\*.cs" Exclude="bin\**\*.cs;obj\**\*.cs" />
  </ItemGroup>
</Project>
