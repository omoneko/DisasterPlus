<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AssemblyName>WaterSolverSim</AssemblyName>
    <RootNamespace>DisasterPlus.Tools.WaterSolverSim</RootNamespace>
    <LangVersion>7.3</LangVersion>

    <!-- ★ This tool walks N*N cells twice for every frame. With unoptimised Debug code a
         single frame at 512x512 takes close to 0.2 seconds, which makes checking 1500
         frames impractical. `dotnet run` uses the Debug configuration by default, so
         optimisation is turned on here whatever the configuration is. -->
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!-- Compile the real Core sources as they are. **Not a rewritten approximation.**
       What is needed here is DisasterPlus.Core.Earthquake.TsunamiSource (the staging of the
       forcing), so that what drives the simulation is not one byte different from what the
       mod uses in the game. -->
  <ItemGroup>
    <Compile Include="..\..\src\DisasterPlus\Core\**\*.cs" />
    <Compile Include="..\Shared\Png.cs" />
  </ItemGroup>

</Project>
